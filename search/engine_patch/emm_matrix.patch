+
+/// The root payoff matrix of a fixed-depth expectiminimax search, every cell evaluated
+/// (`ab_prune` false; the subgames below the root still use the engine's pruned search).
+/// Added for search at decision time with an opponent model (pokemon-rl, step 6).
+#[pyfunction]
+fn emm_matrix(py_state: PyState, depth: i8, ab_prune: bool) -> PyResult<PyIterativeDeepeningResult> {
+    let mut state: State = py_state.into();
+    let (s1_options, s2_options) = state.root_get_all_options();
+    let running = Arc::new(Mutex::new(true));
+    let matrix = expectiminimax_search(
+        &mut state,
+        depth,
+        s1_options.clone(),
+        s2_options.clone(),
+        ab_prune,
+        &running,
+    );
+    Ok(PyIterativeDeepeningResult::from_iterative_deepening_result(
+        (s1_options, s2_options, matrix, depth),
+        &state,
+    ))
 }
 
