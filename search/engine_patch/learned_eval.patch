+/// The features of the learned leaf evaluation (engine::learned) for each serialized state,
+/// flattened (len(feature_names()) per state). Added for pokemon-rl, step 7.
+#[pyfunction]
+fn features_from_strings(states: Vec<String>) -> PyResult<Vec<f32>> {
+    let n = learned::N_FEATURES;
+    let mut out = vec![0f32; states.len() * n];
+    for (i, s) in states.iter().enumerate() {
+        let state = State::deserialize(s);
+        learned::features(&state, &mut out[i * n..(i + 1) * n]);
+    }
+    Ok(out)
+}
+
+#[pyfunction]
+fn feature_names() -> Vec<String> {
+    let mut names = Vec::with_capacity(learned::N_FEATURES);
+    for side in ["s1", "s2"] {
+        for n in learned::SIDE_NAMES.iter() {
+            names.push(format!("{}_{}", side, n));
+        }
+    }
+    for n in learned::CROSS_NAMES.iter() {
+        names.push(n.to_string());
+    }
+    names
+}
