+fn learned_evaluator(id: usize) -> PyResult<Option<Arc<learned::Evaluator>>> {
+    if id == 0 {
+        return Ok(None);
+    }
+    match learned::get(id) {
+        Some(e) => Ok(Some(e)),
+        None => Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(format!(
+            "no evaluator {}",
+            id
+        ))),
+    }
+}
+
+/// The features of the learned leaf evaluation (engine::learned) for each serialized state,
+/// flattened (len(feature_names()) per state). Added for pokemon-rl, step 7.
+#[pyfunction]
+fn features_from_strings(states: Vec<String>) -> PyResult<Vec<f32>> {
+    let n = learned::N_FEATURES;
+    let mut out = vec![0f32; states.len() * n];
+    for (i, s) in states.iter().enumerate() {
+        let state = State::deserialize(s);
+        learned::features(&state, &mut out[i * n..(i + 1) * n]);
+    }
+    Ok(out)
+}
+
+#[pyfunction]
+fn feature_names() -> Vec<String> {
+    let mut names = Vec::with_capacity(learned::N_FEATURES);
+    for side in ["s1", "s2"] {
+        for n in learned::SIDE_NAMES.iter() {
+            names.push(format!("{}_{}", side, n));
+        }
+    }
+    for n in learned::CROSS_NAMES.iter() {
+        names.push(n.to_string());
+    }
+    names
+}
+
+/// Register a learned leaf evaluation (engine::learned::Evaluator) for mcts_with; returns its id.
+#[pyfunction]
+fn load_evaluator(
+    hidden: usize,
+    w1: Vec<f32>,
+    b1: Vec<f32>,
+    w2: Vec<f32>,
+    mode: u8,
+    scale: f32,
+) -> PyResult<usize> {
+    match learned::Evaluator::new(hidden, w1, b1, w2, mode, scale) {
+        Ok(e) => Ok(learned::register(e)),
+        Err(msg) => Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(msg)),
+    }
+}
+
+fn with_root_weights(
+    e: Option<Arc<learned::Evaluator>>,
+    root_weights: Option<Vec<f32>>,
+) -> PyResult<Option<Arc<learned::Evaluator>>> {
+    match (e, root_weights) {
+        (e, None) => Ok(e),
+        (None, Some(_)) => Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(
+            "root_weights need a learned evaluator",
+        )),
+        (Some(e), Some(w)) => match e.with_root_weights(w) {
+            Ok(e) => Ok(Some(Arc::new(e))),
+            Err(msg) => Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(msg)),
+        },
+    }
+}
+
+/// An evaluator's value of each serialized state: the logit of side one winning (evaluator 0:
+/// the hand-written evaluate()); root_weights: matchup weights (engine::learned) for all of them.
+#[pyfunction]
+#[pyo3(signature = (evaluator, states, root_weights=None))]
+fn evaluator_values(
+    evaluator: usize,
+    states: Vec<String>,
+    root_weights: Option<Vec<f32>>,
+) -> PyResult<Vec<f32>> {
+    let e = with_root_weights(learned_evaluator(evaluator)?, root_weights)?;
+    Ok(states
+        .iter()
+        .map(|s| {
+            let state = State::deserialize(s);
+            match &e {
+                None => evaluate(&state),
+                Some(e) => e.value(&state),
+            }
+        })
+        .collect())
+}
+
+/// mcts on one thread with a learned leaf evaluation (evaluator 0: the hand-written one) and,
+/// optionally, the matchup weights of this search (root_weights, engine::learned).
+#[pyfunction]
+#[pyo3(signature = (py_state, duration_ms, iterations, evaluator, root_weights=None))]
+fn mcts_with(
+    py_state: PyState,
+    duration_ms: u64,
+    mut iterations: u32,
+    evaluator: usize,
+    root_weights: Option<Vec<f32>>,
+) -> PyResult<PyMctsResult> {
+    let e = with_root_weights(learned_evaluator(evaluator)?, root_weights)?;
+    let mut state: State = py_state.into();
+    let duration = Duration::from_millis(duration_ms);
+    let (s1_options, s2_options) = state.root_get_all_options();
+    if s1_options.len() <= 1 {
+        iterations = 100; // as mcts
+    }
+    let mcts_result = perform_mcts_with(
+        &mut state,
+        s1_options,
+        s2_options,
+        duration,
+        iterations,
+        e.as_deref(),
+    );
+    Ok(PyMctsResult::from_mcts_result(mcts_result, &state))
+}
+
+/// The inputs of the matchup-weight network (engine::learned::matchup_inputs) for each serialized
+/// state, flattened: (ints, floats), matchup_layout()'s sizes per state.
+#[pyfunction]
+fn matchup_inputs_from_strings(states: Vec<String>) -> PyResult<(Vec<i32>, Vec<f32>)> {
+    let (ni, nf) = (learned::N_MATCHUP_INTS, learned::N_MATCHUP_FLOATS);
+    let mut ints = vec![0i32; states.len() * ni];
+    let mut floats = vec![0f32; states.len() * nf];
+    for (i, s) in states.iter().enumerate() {
+        let state = State::deserialize(s);
+        learned::matchup_inputs(
+            &state,
+            &mut ints[i * ni..(i + 1) * ni],
+            &mut floats[i * nf..(i + 1) * nf],
+        );
+    }
+    Ok((ints, floats))
+}
+
+/// matchup_inputs_from_strings for one State.
+#[pyfunction]
+fn matchup_inputs(py_state: PyState) -> PyResult<(Vec<i32>, Vec<f32>)> {
+    let state: State = py_state.into();
+    let mut ints = vec![0i32; learned::N_MATCHUP_INTS];
+    let mut floats = vec![0f32; learned::N_MATCHUP_FLOATS];
+    learned::matchup_inputs(&state, &mut ints, &mut floats);
+    Ok((ints, floats))
+}
+
+/// The per-Pokemon leaf features (engine::learned::leaf_features) of each serialized state:
+/// side one's 6 x M_LEAF, side two's, then the 36 one-hot of the active pair (both alive).
+#[pyfunction]
+fn leaf_features_from_strings(states: Vec<String>) -> PyResult<Vec<f32>> {
+    let m = learned::M_LEAF;
+    let n = 12 * m + 36;
+    let mut out = vec![0f32; states.len() * n];
+    for (i, s) in states.iter().enumerate() {
+        let state = State::deserialize(s);
+        let o = &mut out[i * n..(i + 1) * n];
+        for slot in 0..6 {
+            learned::leaf_features(&state.side_one, slot, &mut o[slot * m..(slot + 1) * m]);
+            learned::leaf_features(&state.side_two, slot, &mut o[(6 + slot) * m..(7 + slot) * m]);
+        }
+        let a1 = state.side_one.active_index as usize;
+        let a2 = state.side_two.active_index as usize;
+        if state.side_one.pokemon.pkmn[a1].hp > 0 && state.side_two.pokemon.pkmn[a2].hp > 0 {
+            o[12 * m + a1 * 6 + a2] = 1.0;
+        }
+    }
+    Ok(out)
+}
+
+/// The pairwise matchup features (engine::learned::pair_features, 36 x N_PAIR) of each serialized
+/// state, flattened.
+#[pyfunction]
+fn pair_features_from_strings(states: Vec<String>) -> PyResult<Vec<f32>> {
+    let n = 36 * learned::N_PAIR;
+    let mut out = vec![0f32; states.len() * n];
+    for (i, s) in states.iter().enumerate() {
+        let state = State::deserialize(s);
+        learned::pair_features(&state, &mut out[i * n..(i + 1) * n]);
+    }
+    Ok(out)
+}
+
+/// pair_features_from_strings for one State, and the feature names.
+#[pyfunction]
+fn pair_features(py_state: PyState) -> PyResult<Vec<f32>> {
+    let state: State = py_state.into();
+    let mut out = vec![0f32; 36 * learned::N_PAIR];
+    learned::pair_features(&state, &mut out);
+    Ok(out)
+}
+
+#[pyfunction]
+fn pair_feature_names() -> Vec<String> {
+    learned::PAIR_NAMES.iter().map(|s| s.to_string()).collect()
+}
+
+/// Static move data by the Choices enum's value (0 = NONE): ints (type, category: 0 physical,
+/// 1 special, 2 status, 3 switch; priority) and floats (base power / 100, accuracy / 100).
+#[pyfunction]
+fn move_table() -> (Vec<i32>, Vec<f32>) {
+    let (mut ints, mut floats) = (Vec::new(), Vec::new());
+    let mut i: u16 = 0;
+    loop {
+        let c = Choices::from(i);
+        if i > 0 && c == Choices::NONE {
+            break;
+        }
+        match MOVES.get(&c) {
+            Some(m) => {
+                ints.extend_from_slice(&[m.move_type as i32, m.category.clone() as i32, m.priority as i32]);
+                floats.extend_from_slice(&[m.base_power / 100.0, m.accuracy / 100.0]);
+            }
+            None => {
+                ints.extend_from_slice(&[0, 2, 0]);
+                floats.extend_from_slice(&[0.0, 1.0]);
+            }
+        }
+        i += 1;
+    }
+    (ints, floats)
+}
+
+/// Sizes for the matchup weights: N_POKE_INTS, N_POKE_FLOATS, N_FIELD, M_LEAF, N_FEATURES,
