+//! A learned leaf evaluation for MCTS (pokemon-rl, step 7): features of a state and a small
+//! antisymmetric model on them, v(state) = g(x) - g(swap(x)), the logit of side one winning.
+//! x = [side features of side one, of side two, cross features]; swap(x) exchanges the two
+//! sides and negates the cross features (they are antisymmetric), so v(mirror) = -v exactly.
+//! Training (Python) reads the same features through the `features_from_strings` binding.
+//!
+//! Matchup weights (step 8): a network (search/matchup_eval.py) looks at the root of a search once
+//! and sets weights for per-Pokemon leaf features, kept for every leaf of that search:
+//! v(state) += sum over side one's Pokemon p of w_p . phi_p(state) - the same over side two's
+//! + W[side one's active][side two's active] (both alive). `matchup_inputs` gives the network's
+//! inputs, `leaf_features` the phi.
+
+use super::abilities::Abilities;
+use super::damage_calc::type_effectiveness_modifier;
+use super::evaluate::evaluate;
+use super::generate_instructions::get_effective_speed;
+use super::items::Items;
+use super::state::PokemonVolatileStatus;
+use crate::choices::{Choices, MoveCategory};
+use crate::state::{
+    Pokemon, PokemonBoostableStat, PokemonStatus, PokemonType, Side, SideReference, State,
+};
+use std::sync::{Arc, Mutex};
+
+pub const SIDE_NAMES: [&str; 52] = [
+    "alive1", "alive2", "alive3", "alive4", "alive5", "alive6", // one-hot of the number alive
+    "hp_sum", "hp_sq_sum", "active_hp", "items", "tera_used", "active_tera",
+    "burn_phys", "burned", "frozen", "asleep", "paralyzed", "toxic", "poisoned", "status_good",
+    "active_status",
+    "rocks", "rocks_dmg", "spikes", "tspikes", "web",
+    "atk_boost", "def_boost", "spa_boost", "spd_boost", "spe_boost", "acc_boost", "eva_boost",
+    "leechseed", "substitute", "confusion", "taunt", "encore", "yawn", "perish", "trapped",
+    "saltcure",
+    "reflect", "lightscreen", "auroraveil", "safeguard", "tailwind", "healingwish", "wish",
+    "futuresight",
+    "stats_alive", "force_switch",
+];
+pub const CROSS_NAMES: [&str; 6] = [
+    "hand_eval", "faster", "dmg", "ko", "ko_first", "dmg_first",
+];
+pub const N_SIDE: usize = SIDE_NAMES.len();
+pub const N_CROSS: usize = CROSS_NAMES.len();
+pub const N_FEATURES: usize = 2 * N_SIDE + N_CROSS;
+
+fn boost_multiplier(boost: i8) -> f32 {
+    // evaluate.rs's table
+    match boost.clamp(-6, 6) {
+        6 => 3.3,
+        5 => 3.15,
+        4 => 3.0,
+        3 => 2.5,
+        2 => 2.0,
+        1 => 1.0,
+        0 => 0.0,
+        -1 => -1.0,
+        -2 => -2.0,
+        -3 => -2.5,
+        -4 => -3.0,
+        -5 => -3.15,
+        _ => -3.3,
+    }
+}
+
+fn status_is_good(p: &Pokemon) -> bool {
+    match p.ability {
+        Abilities::GUTS | Abilities::MARVELSCALE | Abilities::QUICKFEET | Abilities::MAGICGUARD => {
+            true
+        }
+        Abilities::POISONHEAL | Abilities::TOXICBOOST => {
+            p.status == PokemonStatus::POISON || p.status == PokemonStatus::TOXIC
+        }
+        _ => false,
+    }
+}
+
+fn burn_physical(p: &Pokemon) -> f32 {
+    // evaluate.rs's burn weight: physical moves, halved for special attackers
+    let mut m = 0.0;
+    for mv in p.moves.into_iter() {
+        if mv.choice.category == MoveCategory::Physical {
+            m += 1.0;
+        }
+    }
+    if p.special_attack > p.attack {
+        m /= 2.0;
+    }
+    m
+}
+
+fn b(x: bool) -> f32 {
+    if x {
+        1.0
+    } else {
+        0.0
+    }
+}
+
+fn side_features(side: &Side, out: &mut [f32]) {
+    for v in out.iter_mut() {
+        *v = 0.0;
+    }
+    let active = side.get_active_immutable();
+    let sc = &side.side_conditions;
+    let mut n_alive = 0usize;
+    for p in side.pokemon.pkmn.iter() {
+        let is_active = std::ptr::eq(p, active);
+        if p.terastallized {
+            out[10] = 1.0;
+            if is_active {
+                out[11] = 1.0;
+            }
+        }
+        if p.hp <= 0 {
+            continue;
+        }
+        n_alive += 1;
+        let f = p.hp as f32 / (p.maxhp.max(1)) as f32;
+        out[6] += f;
+        out[7] += f * f;
+        if is_active {
+            out[8] = f;
+        }
+        if p.item != Items::NONE {
+            out[9] += 1.0;
+        }
+        if p.status != PokemonStatus::NONE {
+            if is_active {
+                out[20] = 1.0;
+            }
+            if status_is_good(p) {
+                out[19] += 1.0;
+            } else {
+                match p.status {
+                    PokemonStatus::BURN => {
+                        out[12] += burn_physical(p);
+                        out[13] += 1.0;
+                    }
+                    PokemonStatus::FREEZE => out[14] += 1.0,
+                    PokemonStatus::SLEEP => out[15] += 1.0,
+                    PokemonStatus::PARALYZE => out[16] += 1.0,
+                    PokemonStatus::TOXIC => out[17] += 1.0,
+                    PokemonStatus::POISON => out[18] += 1.0,
+                    PokemonStatus::NONE => {}
+                }
+            }
+        }
+        if p.item != Items::HEAVYDUTYBOOTS {
+            let grounded = p.is_grounded();
+            if p.ability != Abilities::MAGICGUARD {
+                if sc.stealth_rock > 0 {
+                    out[21] += 1.0;
+                    out[22] += type_effectiveness_modifier(&PokemonType::ROCK, p) / 8.0;
+                }
+                if grounded {
+                    out[23] += sc.spikes as f32;
+                    out[24] += sc.toxic_spikes as f32;
+                }
+            }
+            if grounded {
+                out[25] += sc.sticky_web as f32;
+            }
+        }
+        let stats = p.attack as f32
+            + p.defense as f32
+            + p.special_attack as f32
+            + p.special_defense as f32
+            + p.speed as f32
+            + p.maxhp as f32;
+        out[50] += f * stats / 1000.0;
+    }
+    if n_alive >= 1 {
+        out[n_alive.min(6) - 1] = 1.0;
+    }
+    if active.hp > 0 {
+        out[26] = boost_multiplier(side.attack_boost);
+        out[27] = boost_multiplier(side.defense_boost);
+        out[28] = boost_multiplier(side.special_attack_boost);
+        out[29] = boost_multiplier(side.special_defense_boost);
+        out[30] = boost_multiplier(side.speed_boost);
+        out[31] = side.accuracy_boost as f32 / 6.0;
+        out[32] = side.evasion_boost as f32 / 6.0;
+        let v = &side.volatile_statuses;
+        out[33] = b(v.contains(&PokemonVolatileStatus::LEECHSEED));
+        out[34] = b(v.contains(&PokemonVolatileStatus::SUBSTITUTE));
+        out[35] = b(v.contains(&PokemonVolatileStatus::CONFUSION));
+        out[36] = b(v.contains(&PokemonVolatileStatus::TAUNT));
+        out[37] = b(v.contains(&PokemonVolatileStatus::ENCORE));
+        out[38] = b(v.contains(&PokemonVolatileStatus::YAWN));
+        out[39] = b(v.contains(&PokemonVolatileStatus::PERISH1)
+            || v.contains(&PokemonVolatileStatus::PERISH2)
+            || v.contains(&PokemonVolatileStatus::PERISH3)
+            || v.contains(&PokemonVolatileStatus::PERISH4));
+        out[40] = b(v.contains(&PokemonVolatileStatus::PARTIALLYTRAPPED));
+        out[41] = b(v.contains(&PokemonVolatileStatus::SALTCURE));
+    }
+    out[42] = b(sc.reflect > 0);
+    out[43] = b(sc.light_screen > 0);
+    out[44] = b(sc.aurora_veil > 0);
+    out[45] = b(sc.safeguard > 0);
+    out[46] = b(sc.tailwind > 0);
+    out[47] = b(sc.healing_wish > 0);
+    out[48] = b(side.wish.0 > 0);
+    out[49] = b(side.future_sight.0 > 0);
+    out[51] = b(side.force_switch);
+}
+
+fn immune_by_ability(defender: &Pokemon, move_type: &PokemonType) -> bool {
+    match move_type {
+        PokemonType::GROUND => {
+            defender.ability == Abilities::EARTHEATER || !defender.is_grounded()
+        }
+        PokemonType::FIRE => matches!(
+            defender.ability,
+            Abilities::FLASHFIRE | Abilities::WELLBAKEDBODY
+        ),
+        PokemonType::WATER => matches!(
+            defender.ability,
+            Abilities::WATERABSORB | Abilities::STORMDRAIN | Abilities::DRYSKIN
+        ),
+        PokemonType::ELECTRIC => matches!(
+            defender.ability,
+            Abilities::VOLTABSORB | Abilities::LIGHTNINGROD | Abilities::MOTORDRIVE
+        ),
+        PokemonType::GRASS => defender.ability == Abilities::SAPSIPPER,
+        _ => false,
+    }
+}
+
+fn stab(move_type: &PokemonType, p: &Pokemon) -> f32 {
+    // damage_calc.rs's stab_modifier
+    if move_type == &PokemonType::TYPELESS {
+        return 1.0;
+    }
+    let basic = move_type == &p.types.0 || move_type == &p.types.1;
+    if p.terastallized {
+        if &p.tera_type == move_type && basic {
+            return 2.0;
+        } else if &p.tera_type == move_type || basic {
+            return 1.5;
+        }
+    } else if basic {
+        return 1.5;
+    }
+    1.0
+}
+
+/// A rough best-move damage estimate of the active attacker against the active defender, as a
+/// fraction of the defender's current HP (capped at 1): the damage formula with boosted stats,
+/// STAB, type effectiveness, ability immunities and burn; no items, weather, screens or
+/// variable-power and fixed-damage moves.
+fn damage_fraction(att_side: &Side, att: &Pokemon, def_side: &Side, def: &Pokemon) -> f32 {
+    let mut best = 0.0f32;
+    let level = att.level as f32;
+    for mv in att.moves.into_iter() {
+        let c = &mv.choice;
+        if mv.disabled || mv.pp <= 0 || c.base_power <= 0.0 {
+            continue;
+        }
+        let (a, d) = match c.category {
+            MoveCategory::Physical => (
+                att_side.calculate_boosted_stat(PokemonBoostableStat::Attack),
+                def_side.calculate_boosted_stat(PokemonBoostableStat::Defense),
+            ),
+            MoveCategory::Special => (
+                att_side.calculate_boosted_stat(PokemonBoostableStat::SpecialAttack),
+                def_side.calculate_boosted_stat(PokemonBoostableStat::SpecialDefense),
+            ),
+            _ => continue,
+        };
+        if immune_by_ability(def, &c.move_type) {
+            continue;
+        }
+        let eff = type_effectiveness_modifier(&c.move_type, def);
+        if eff == 0.0 {
+            continue;
+        }
+        let mut dmg = ((2.0 * level / 5.0 + 2.0) * c.base_power * a as f32 / (d.max(1) as f32))
+            / 50.0
+            + 2.0;
+        dmg *= stab(&c.move_type, att) * eff * 0.925;
+        if c.category == MoveCategory::Physical
+            && att.status == PokemonStatus::BURN
+            && att.ability != Abilities::GUTS
+        {
+            dmg *= 0.5;
+        }
+        if def.ability == Abilities::THICKFAT
+            && (c.move_type == PokemonType::FIRE || c.move_type == PokemonType::ICE)
+        {
+            dmg *= 0.5;
+        }
+        best = best.max(dmg);
+    }
+    (best / (def.hp.max(1) as f32)).min(1.0)
+}
+
+fn cross_features(state: &State, out: &mut [f32]) {
+    for v in out.iter_mut() {
+        *v = 0.0;
+    }
+    out[0] = evaluate(state) / 100.0;
+    let a1 = state.side_one.get_active_immutable();
+    let a2 = state.side_two.get_active_immutable();
+    if a1.hp <= 0 || a2.hp <= 0 {
+        return;
+    }
+    let s1 = get_effective_speed(state, &SideReference::SideOne);
+    let s2 = get_effective_speed(state, &SideReference::SideTwo);
+    let (mut f1, mut f2) = (b(s1 > s2), b(s2 > s1));
+    if state.trick_room.active {
+        std::mem::swap(&mut f1, &mut f2);
+    }
+    let d12 = damage_fraction(&state.side_one, a1, &state.side_two, a2);
+    let d21 = damage_fraction(&state.side_two, a2, &state.side_one, a1);
+    let (k12, k21) = (b(d12 >= 1.0), b(d21 >= 1.0));
+    out[1] = f1 - f2;
+    out[2] = d12 - d21;
+    out[3] = k12 - k21;
+    out[4] = k12 * f1 - k21 * f2;
+    out[5] = d12 * f1 - d21 * f2;
+}
+
+/// The features of `state` into `out` (N_FEATURES).
+pub fn features(state: &State, out: &mut [f32]) {
+    side_features(&state.side_one, &mut out[..N_SIDE]);
+    side_features(&state.side_two, &mut out[N_SIDE..2 * N_SIDE]);
+    cross_features(state, &mut out[2 * N_SIDE..N_FEATURES]);
+}
+
+fn swap(x: &[f32], y: &mut [f32]) {
+    y[..N_SIDE].copy_from_slice(&x[N_SIDE..2 * N_SIDE]);
+    y[N_SIDE..2 * N_SIDE].copy_from_slice(&x[..N_SIDE]);
+    for i in 2 * N_SIDE..N_FEATURES {
+        y[i] = -x[i];
+    }
+}
+
+fn dot(a: &[f32], b: &[f32]) -> f32 {
+    // 8 independent sums, so the compiler vectorizes it
+    let mut acc = [0f32; 8];
+    let (ca, cb) = (a.chunks_exact(8), b.chunks_exact(8));
+    let mut s = 0.0;
+    for (x, y) in ca.remainder().iter().zip(cb.remainder()) {
+        s += x * y;
+    }
+    for (x, y) in ca.zip(cb) {
+        for i in 0..8 {
+            acc[i] += x[i] * y[i];
+        }
+    }
+    s + acc.iter().sum::<f32>()
+}
+
+/// g(x) = w2 . relu(W1 x + b1) (hidden > 0) or w . x (hidden 0); v = g(x) - g(swap(x)).
+/// mode 1: leaf score sigmoid(v); mode 2: sigmoid(scale * (v - v(root))).
+/// root_weights (empty, or N_ROOT_WEIGHTS for one search): the matchup term added to v.
+#[derive(Clone)]
+pub struct Evaluator {
+    pub hidden: usize,
+    pub w1: Vec<f32>,
+    pub b1: Vec<f32>,
+    pub w2: Vec<f32>,
+    pub mode: u8,
+    pub scale: f32,
+    linear: Vec<f32>, // hidden 0: v = linear . x
+    pub root_weights: Vec<f32>,
+}
+
+impl Evaluator {
+    pub fn new(
+        hidden: usize,
+        w1: Vec<f32>,
+        b1: Vec<f32>,
+        w2: Vec<f32>,
+        mode: u8,
+        scale: f32,
+    ) -> Result<Evaluator, String> {
+        let rows = hidden.max(1);
+        if w1.len() != rows * N_FEATURES {
+            return Err(format!("w1 has {} values, expected {}", w1.len(), rows * N_FEATURES));
+        }
+        if hidden > 0 && (b1.len() != hidden || w2.len() != hidden) {
+            return Err(format!("b1 and w2 need {} values each", hidden));
+        }
+        if mode != 1 && mode != 2 {
+            return Err(format!("mode {} (1: absolute, 2: relative to the root)", mode));
+        }
+        let mut linear = vec![0f32; N_FEATURES];
+        if hidden == 0 {
+            for i in 0..N_SIDE {
+                linear[i] = w1[i] - w1[N_SIDE + i];
+                linear[N_SIDE + i] = w1[N_SIDE + i] - w1[i];
+            }
+            for i in 2 * N_SIDE..N_FEATURES {
+                linear[i] = 2.0 * w1[i];
+            }
+        }
+        Ok(Evaluator {
+            hidden,
+            w1,
+            b1,
+            w2,
+            mode,
+            scale,
+            linear,
+            root_weights: Vec::new(),
+        })
+    }
+
+    /// A copy with the matchup weights of one search: side one's 6 Pokemon x M_LEAF, side two's,
+    /// then W (36, side one's slot * 6 + side two's slot).
+    pub fn with_root_weights(&self, w: Vec<f32>) -> Result<Evaluator, String> {
+        if w.len() != N_ROOT_WEIGHTS {
+            return Err(format!("root_weights has {} values, expected {}", w.len(), N_ROOT_WEIGHTS));
+        }
+        let mut e = self.clone();
+        e.root_weights = w;
+        Ok(e)
+    }
+
+    fn matchup_value(&self, state: &State) -> f32 {
+        let w = &self.root_weights;
+        let mut phi = [0f32; M_LEAF];
+        let mut s = 0.0;
+        for slot in 0..6 {
+            if leaf_features(&state.side_one, slot, &mut phi) {
+                s += dot(&w[slot * M_LEAF..(slot + 1) * M_LEAF], &phi);
+            }
+            if leaf_features(&state.side_two, slot, &mut phi) {
+                s -= dot(&w[(6 + slot) * M_LEAF..(7 + slot) * M_LEAF], &phi);
+            }
+        }
+        let a1 = state.side_one.active_index as usize;
+        let a2 = state.side_two.active_index as usize;
+        if state.side_one.pokemon.pkmn[a1].hp > 0 && state.side_two.pokemon.pkmn[a2].hp > 0 {
+            s += w[12 * M_LEAF + a1 * 6 + a2];
+        }
+        s
+    }
+
+    fn g(&self, x: &[f32]) -> f32 {
+        let mut s = 0.0;
+        for h in 0..self.hidden {
+            let z = dot(&self.w1[h * N_FEATURES..(h + 1) * N_FEATURES], x) + self.b1[h];
+            if z > 0.0 {
+                s += self.w2[h] * z;
+            }
+        }
+        s
+    }
+
+    /// The logit of side one winning.
+    pub fn value(&self, state: &State) -> f32 {
+        let mut x = [0f32; N_FEATURES];
+        features(state, &mut x);
+        let v = if self.hidden == 0 {
+            dot(&self.linear, &x)
+        } else {
+            let mut y = [0f32; N_FEATURES];
+            swap(&x, &mut y);
+            self.g(&x) - self.g(&y)
+        };
+        if self.root_weights.is_empty() {
+            v
+        } else {
+            v + self.matchup_value(state)
+        }
+    }
+
+    /// The MCTS score of a leaf (0..1, for side one) given the root's value.
+    pub fn score(&self, state: &State, root_value: f32) -> f32 {
+        let v = self.value(state);
+        let z = if self.mode == 2 {
+            self.scale * (v - root_value)
+        } else {
+            v
+        };
+        1.0 / (1.0 + (-z).exp())
+    }
+}
+
+// ---- matchup weights: per-Pokemon leaf features and the network's inputs ---------------------
+
+pub const LEAF_NAMES: [&str; 16] = [
+    "alive", "hp", "hp_sq", "burn", "paralyze", "sleep", "freeze", "poison", "item", "tera",
+    "active", "atk_boost", "def_boost", "spa_boost", "spd_boost", "spe_boost",
+];
+pub const M_LEAF: usize = LEAF_NAMES.len();
+pub const N_ROOT_WEIGHTS: usize = 12 * M_LEAF + 36;
+/// Per Pokemon: species, ability, item, types (2), tera type, status, moves (4); as the enums' values.
+pub const N_POKE_INTS: usize = 11;
+/// Per Pokemon: alive, hp, level, stats (6), active, terastallized, boosts (7, active only),
+/// status_good, sleep and rest turns, moves usable (4).
+pub const N_POKE_FLOATS: usize = 25;
+/// Weather (8 one-hot, turns), terrain (5 one-hot, turns), trick room (active, turns).
+pub const N_FIELD: usize = 17;
+pub const N_MATCHUP_INTS: usize = 12 * N_POKE_INTS + 2;
+pub const N_MATCHUP_FLOATS: usize = 12 * N_POKE_FLOATS + N_FIELD + N_FEATURES;
+
+/// The leaf features of the Pokemon in `slot` (M_LEAF, all 0 if it has fainted; returns alive).
+pub fn leaf_features(side: &Side, slot: usize, out: &mut [f32]) -> bool {
+    for v in out.iter_mut() {
+        *v = 0.0;
+    }
+    let p = &side.pokemon.pkmn[slot];
+    if p.hp <= 0 {
+        return false;
+    }
+    let f = p.hp as f32 / (p.maxhp.max(1)) as f32;
+    out[0] = 1.0;
+    out[1] = f;
+    out[2] = f * f;
+    match p.status {
+        PokemonStatus::BURN => out[3] = 1.0,
+        PokemonStatus::PARALYZE => out[4] = 1.0,
+        PokemonStatus::SLEEP => out[5] = 1.0,
+        PokemonStatus::FREEZE => out[6] = 1.0,
+        PokemonStatus::POISON | PokemonStatus::TOXIC => out[7] = 1.0,
+        PokemonStatus::NONE => {}
+    }
+    out[8] = b(p.item != Items::NONE);
+    out[9] = b(p.terastallized);
+    if side.active_index as usize == slot {
+        out[10] = 1.0;
+        out[11] = boost_multiplier(side.attack_boost);
+        out[12] = boost_multiplier(side.defense_boost);
+        out[13] = boost_multiplier(side.special_attack_boost);
+        out[14] = boost_multiplier(side.special_defense_boost);
+        out[15] = boost_multiplier(side.speed_boost);
+    }
+    true
+}
+
+fn pokemon_token(side: &Side, slot: usize, ints: &mut [i32], floats: &mut [f32]) {
+    for v in floats.iter_mut() {
+        *v = 0.0;
+    }
+    let p = &side.pokemon.pkmn[slot];
+    ints[0] = p.id as i32;
+    ints[1] = p.ability as i32;
+    ints[2] = p.item as i32;
+    ints[3] = p.types.0 as i32;
+    ints[4] = p.types.1 as i32;
+    ints[5] = p.tera_type as i32;
+    ints[6] = p.status as i32;
+    let alive = p.hp > 0;
+    floats[0] = b(alive);
+    if alive {
+        floats[1] = p.hp as f32 / (p.maxhp.max(1)) as f32;
+    }
+    floats[2] = p.level as f32 / 100.0;
+    floats[3] = p.maxhp as f32 / 400.0;
+    floats[4] = p.attack as f32 / 400.0;
+    floats[5] = p.defense as f32 / 400.0;
+    floats[6] = p.special_attack as f32 / 400.0;
+    floats[7] = p.special_defense as f32 / 400.0;
+    floats[8] = p.speed as f32 / 400.0;
+    let active = side.active_index as usize == slot;
+    floats[9] = b(active);
+    floats[10] = b(p.terastallized);
+    if active {
+        floats[11] = side.attack_boost as f32 / 6.0;
+        floats[12] = side.defense_boost as f32 / 6.0;
+        floats[13] = side.special_attack_boost as f32 / 6.0;
+        floats[14] = side.special_defense_boost as f32 / 6.0;
+        floats[15] = side.speed_boost as f32 / 6.0;
+        floats[16] = side.accuracy_boost as f32 / 6.0;
+        floats[17] = side.evasion_boost as f32 / 6.0;
+    }
+    floats[18] = b(status_is_good(p));
+    floats[19] = p.sleep_turns as f32 / 3.0;
+    floats[20] = p.rest_turns as f32 / 3.0;
+    for (k, mv) in [&p.moves.m0, &p.moves.m1, &p.moves.m2, &p.moves.m3].iter().enumerate() {
+        ints[7 + k] = mv.id as i32;
+        floats[21 + k] = b(mv.id != Choices::NONE && mv.pp > 0 && !mv.disabled);
+    }
+}
+
+fn field_features(state: &State, out: &mut [f32]) {
+    for v in out.iter_mut() {
+        *v = 0.0;
+    }
+    out[(state.weather.weather_type as usize).min(7)] = 1.0;
+    out[8] = state.weather.turns_remaining.max(0) as f32 / 5.0;
+    out[9 + (state.terrain.terrain_type as usize).min(4)] = 1.0;
+    out[14] = state.terrain.turns_remaining.max(0) as f32 / 5.0;
+    out[15] = b(state.trick_room.active);
+    out[16] = state.trick_room.turns_remaining.max(0) as f32 / 5.0;
+}
+
+/// The network's inputs: ints (N_MATCHUP_INTS: each Pokemon's N_POKE_INTS, side one's slots then
+/// side two's, then the two active slots) and floats (N_MATCHUP_FLOATS: each Pokemon's
+/// N_POKE_FLOATS, the field, the features of `features`).
+pub fn matchup_inputs(state: &State, ints: &mut [i32], floats: &mut [f32]) {
+    for (k, side) in [&state.side_one, &state.side_two].iter().enumerate() {
+        for slot in 0..6 {
+            let i = k * 6 + slot;
+            pokemon_token(
+                side,
+                slot,
+                &mut ints[i * N_POKE_INTS..(i + 1) * N_POKE_INTS],
+                &mut floats[i * N_POKE_FLOATS..(i + 1) * N_POKE_FLOATS],
+            );
+        }
+    }
+    ints[12 * N_POKE_INTS] = state.side_one.active_index as i32;
+    ints[12 * N_POKE_INTS + 1] = state.side_two.active_index as i32;
+    let o = 12 * N_POKE_FLOATS;
+    field_features(state, &mut floats[o..o + N_FIELD]);
+    features(state, &mut floats[o + N_FIELD..o + N_FIELD + N_FEATURES]);
+}
+
+// ---- pairwise matchup features (inputs of the matchup network) --------------------------------
+
+pub const PAIR_NAMES: [&str; 9] = [
+    "dmg", "dmg_back", "ko", "ko_back", "faster", "eff", "eff_back", "prio_ko", "prio_ko_back",
+];
+pub const N_PAIR: usize = PAIR_NAMES.len();
+
+/// The best damage of `att` against `def` as a fraction of def's max HP: the damage formula with
+/// unboosted stats, STAB, type effectiveness, ability immunities, burn and Thick Fat (no items,
+/// weather or screens); priority_only: only moves with priority > 0.
+fn raw_damage(att: &Pokemon, def: &Pokemon, priority_only: bool) -> f32 {
+    let mut best = 0.0f32;
+    let level = att.level as f32;
+    for mv in [&att.moves.m0, &att.moves.m1, &att.moves.m2, &att.moves.m3] {
+        let c = &mv.choice;
+        if mv.id == Choices::NONE || mv.disabled || mv.pp <= 0 || c.base_power <= 0.0 {
+            continue;
+        }
+        if priority_only && c.priority <= 0 {
+            continue;
+        }
+        let (a, d) = match c.category {
+            MoveCategory::Physical => (att.attack, def.defense),
+            MoveCategory::Special => (att.special_attack, def.special_defense),
+            _ => continue,
+        };
+        if immune_by_ability(def, &c.move_type) {
+            continue;
+        }
+        let eff = type_effectiveness_modifier(&c.move_type, def);
+        if eff == 0.0 {
+            continue;
+        }
+        let mut dmg = ((2.0 * level / 5.0 + 2.0) * c.base_power * a as f32 / (d.max(1) as f32))
+            / 50.0
+            + 2.0;
+        dmg *= stab(&c.move_type, att) * eff * 0.925;
+        if c.category == MoveCategory::Physical
+            && att.status == PokemonStatus::BURN
+            && att.ability != Abilities::GUTS
+        {
+            dmg *= 0.5;
+        }
+        if def.ability == Abilities::THICKFAT
+            && (c.move_type == PokemonType::FIRE || c.move_type == PokemonType::ICE)
+        {
+            dmg *= 0.5;
+        }
+        best = best.max(dmg);
+    }
+    best / (def.maxhp.max(1) as f32)
+}
+
+/// log2 of the best type effectiveness of att's damaging moves against def (-3: none hits).
+fn best_effectiveness(att: &Pokemon, def: &Pokemon) -> f32 {
+    let mut best = -3.0f32;
+    for mv in [&att.moves.m0, &att.moves.m1, &att.moves.m2, &att.moves.m3] {
+        let c = &mv.choice;
+        if mv.id == Choices::NONE
+            || c.base_power <= 0.0
+            || !matches!(c.category, MoveCategory::Physical | MoveCategory::Special)
+            || immune_by_ability(def, &c.move_type)
+        {
+            continue;
+        }
+        let eff = type_effectiveness_modifier(&c.move_type, def);
+        if eff > 0.0 {
+            best = best.max(eff.log2());
+        }
+    }
+    best
+}
+
+fn rough_speed(side: &Side, slot: usize) -> f32 {
+    let p = &side.pokemon.pkmn[slot];
+    let mut s = if side.active_index as usize == slot {
+        side.calculate_boosted_stat(PokemonBoostableStat::Speed) as f32
+    } else {
+        p.speed as f32
+    };
+    if p.status == PokemonStatus::PARALYZE && p.ability != Abilities::QUICKFEET {
+        s *= 0.5;
+    }
+    if p.item == Items::CHOICESCARF {
+        s *= 1.5;
+    }
+    if side.side_conditions.tailwind > 0 {
+        s *= 2.0;
+    }
+    s
+}
+
+/// For each pair of living Pokemon (side one's slot i, side two's slot j; 36 x N_PAIR, zeros when
+/// either has fainted): i's best damage on j and back (fractions of max HP, capped at 2), whether
+/// it KOs from the current HP, who is faster (+1 / -1, Trick Room included), the best type
+/// effectiveness each way, and whether a priority move KOs.
+pub fn pair_features(state: &State, out: &mut [f32]) {
+    for v in out.iter_mut() {
+        *v = 0.0;
+    }
+    let (s1, s2) = (&state.side_one, &state.side_two);
+    for i in 0..6 {
+        let p = &s1.pokemon.pkmn[i];
+        if p.hp <= 0 {
+            continue;
+        }
+        let hp_p = p.hp as f32 / (p.maxhp.max(1)) as f32;
+        let sp = rough_speed(s1, i);
+        for j in 0..6 {
+            let q = &s2.pokemon.pkmn[j];
+            if q.hp <= 0 {
+                continue;
+            }
+            let hp_q = q.hp as f32 / (q.maxhp.max(1)) as f32;
+            let o = &mut out[(i * 6 + j) * N_PAIR..(i * 6 + j + 1) * N_PAIR];
+            let (d_pq, d_qp) = (raw_damage(p, q, false), raw_damage(q, p, false));
+            o[0] = d_pq.min(2.0);
+            o[1] = d_qp.min(2.0);
+            o[2] = b(d_pq >= hp_q);
+            o[3] = b(d_qp >= hp_p);
+            let sq = rough_speed(s2, j);
+            let mut f = if sp > sq { 1.0 } else if sp < sq { -1.0 } else { 0.0 };
+            if state.trick_room.active {
+                f = -f;
+            }
+            o[4] = f;
+            o[5] = best_effectiveness(p, q);
+            o[6] = best_effectiveness(q, p);
+            o[7] = b(raw_damage(p, q, true) >= hp_q);
+            o[8] = b(raw_damage(q, p, true) >= hp_p);
+        }
+    }
+}
+
+static REGISTRY: Mutex<Vec<Arc<Evaluator>>> = Mutex::new(Vec::new());
+
+/// Keep an evaluator for later searches; returns its id (1, 2, ...; 0 is the hand-written one).
+pub fn register(e: Evaluator) -> usize {
+    let mut r = REGISTRY.lock().unwrap();
+    r.push(Arc::new(e));
+    r.len()
+}
+
+pub fn get(id: usize) -> Option<Arc<Evaluator>> {
+    if id == 0 {
+        return None;
+    }
+    REGISTRY.lock().unwrap().get(id - 1).cloned()
+}
