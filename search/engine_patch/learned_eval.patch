+        vec![
+            learned::N_POKE_INTS,
+            learned::N_POKE_FLOATS,
+            learned::N_FIELD,
+            learned::M_LEAF,
+            learned::N_FEATURES,
+            learned::N_ROOT_WEIGHTS,
+        ],
+        learned::LEAF_NAMES.iter().map(|s| s.to_string()).collect(),
+    )
+}
