+/// Register a learned leaf evaluation (engine::learned::Evaluator) for mcts_with; returns its id.
+#[pyfunction]
+fn load_evaluator(
+    hidden: usize,
+    w1: Vec<f32>,
+    b1: Vec<f32>,
+    w2: Vec<f32>,
+    mode: u8,
+    scale: f32,
+) -> PyResult<usize> {
+    match learned::Evaluator::new(hidden, w1, b1, w2, mode, scale) {
+        Ok(e) => Ok(learned::register(e)),
+        Err(msg) => Err(PyErr::new::<pyo3::exceptions::PyValueError, _>(msg)),
+    }
+}
+
+/// An evaluator's value of each serialized state: the logit of side one winning (evaluator 0:
+/// the hand-written evaluate()).
+#[pyfunction]
+fn evaluator_values(evaluator: usize, states: Vec<String>) -> PyResult<Vec<f32>> {
+    let e = learned_evaluator(evaluator)?;
+    Ok(states
+        .iter()
+        .map(|s| {
+            let state = State::deserialize(s);
+            match &e {
+                None => evaluate(&state),
+                Some(e) => e.value(&state),
+            }
+        })
+        .collect())
+}
+
+/// mcts on one thread with a learned leaf evaluation (evaluator 0: the hand-written one).
+#[pyfunction]
+fn mcts_with(
+    py_state: PyState,
+    duration_ms: u64,
+    mut iterations: u32,
+    evaluator: usize,
+) -> PyResult<PyMctsResult> {
+    let e = learned_evaluator(evaluator)?;
+    let mut state: State = py_state.into();
+    let duration = Duration::from_millis(duration_ms);
+    let (s1_options, s2_options) = state.root_get_all_options();
+    if s1_options.len() <= 1 {
+        iterations = 100; // as mcts
+    }
+    let mcts_result = perform_mcts_with(
+        &mut state,
+        s1_options,
+        s2_options,
+        duration,
+        iterations,
+        e.as_deref(),
+    );
+    Ok(PyMctsResult::from_mcts_result(mcts_result, &state))
+}
